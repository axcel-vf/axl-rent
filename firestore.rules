rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Setiap user yang login hanya bisa baca & tulis dokumen profil miliknya sendiri
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Koleksi orders bisa dibaca & ditulis oleh siapapun yang sudah login
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    // Koleksi cameras bisa dibaca semua orang, ditulis hanya oleh yang login
    match /cameras/{cameraId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
